@model IEnumerable<MvcMasterDetailSPA1294989.Models.Invoice>
@{
    ViewBag.Title = "Invoices";
}

<h2>Invoice List</h2>

<button id="btnCreate" class="btn btn-success mb-2">Add New Invoice</button>

<div id="table-container">
    @Html.Partial("_InvoiceListPartial", Model)
</div>

<div id="modalContainer"></div>


@section scripts {
    <script>
    $(document).ready(function () {
        function refreshInvoiceTable() {
            $.get('@Url.Action("InvoiceListPartial", "Invoices")', function (data) {
                $("#table-container").html(data);
            });
        }

        $("#btnCreate").click(function () {
            $.get('@Url.Action("CreatePartial", "Invoices")', function (data) {
                $("#modalContainer").html('<div class="modal fade show" style="display:block;" aria-modal="true" role="dialog"><div class="modal-dialog modal-lg"><div class="modal-content">' + data + '</div></div></div><div class="modal-backdrop fade show"></div>');
                attachModalEventListeners();
            });
        });

        $('#table-container').on('click', '.edit-btn', function (e) {
            e.preventDefault();
            var editUrl = $(this).attr('href');
            var invoiceId = $(this).closest('tr').data('invoice-id');
            $.get(editUrl, function (data) {
                $("#modalContainer").html('<div class="modal fade show" style="display:block;" aria-modal="true" role="dialog"><div class="modal-dialog modal-lg"><div class="modal-content">' + data + '</div></div></div><div class="modal-backdrop fade show"></div>');
                attachModalEventListeners("Edit", invoiceId);
            });
        });

        $('#table-container').on('click', '.delete-btn', function () {
            var invoiceId = $(this).data('invoice-id');
            if (confirm('Are you sure you want to delete this invoice?')) {
                $.post('@Url.Action("DeleteInvoice", "Invoices")', { id: invoiceId })
                    .done(function (response) {
                        if (response.success) {
                            refreshInvoiceTable();
                        } else {
                            alert('Error deleting invoice: ' + response.message);
                        }
                    });
            }
        });

        function attachModalEventListeners(action = "Create", invoiceId = null) {
            $(document).off("click", ".modal-backdrop, .modal .btn-secondary").on("click", ".modal-backdrop, .modal .btn-secondary", function () {
                $("#modalContainer").empty();
            });
            $(document).off("submit", "#createInvoiceForm, #editInvoiceForm").on("submit", "#createInvoiceForm, #editInvoiceForm", function (e) {
                e.preventDefault();
                var form = $(this);
                var formData = new FormData(this);
                var url = '';

                if (form.attr('id') === "createInvoiceForm" && action === "Create") {
                    url = '@Url.Action("CreateInvoice", "Invoices")';
                } else if (form.attr('id') === "editInvoiceForm" && action === "Edit") {
                    url = '@Url.Action("EditInvoice", "Invoices")';
                    if (invoiceId) { formData.append("InvoiceId", invoiceId); }
                }

                if (url) {
                    $.ajax({
                        url: url,
                        type: 'POST',
                        data: formData,
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.success) {
                                $("#modalContainer").empty();
                                refreshInvoiceTable();
                            } else {
                                $("#modalContainer .modal-content").html(response);
                                attachModalEventListeners(action, invoiceId);
                            }
                        },
                        error: function () { alert("Error performing operation."); }
                    });
                }
            });
        }
    });
    </script>
}