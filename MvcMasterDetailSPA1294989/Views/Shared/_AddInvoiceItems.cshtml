@model List<MvcMasterDetailSPA1294989.Models.InvoiceItem>
<table id="ExTable" class="table table-bordered">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>
                    <input type="text" value="@Model[i].ProductName" class="form-control" name="InvoiceItems[@i].ProductName" />
                </td>
                <td>
                    <input type="number" value="@Model[i].Quantity" class="form-control" name="InvoiceItems[@i].Quantity" />
                </td>
                <td>
                    <input type="number" step="0.01" value="@Model[i].UnitPrice" class="form-control" name="InvoiceItems[@i].UnitPrice" />
                </td>
                <td>
                    <button onclick="deleteItemRow(this)" type="button" class="btn btn-danger">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
<input type="hidden" id="HIndex" value="@Model.Count" />
