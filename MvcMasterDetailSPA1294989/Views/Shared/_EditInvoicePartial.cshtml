@model MvcMasterDetailSPA1294989.ViewModels.InvoiceViewModel
<div class="modal-header">
    <h5 class="modal-title">Edit Invoice</h5>
</div>
<div class="modal-body">
    @using (Html.BeginForm("EditInvoice", "Invoices", FormMethod.Post, new { id = "editInvoiceForm" }))
    { 
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.InvoiceId)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="row">
            <div class="col-md-6">
                <h4>Invoice Information</h4>
                <div class="form-group mb-2">
                    @Html.LabelFor(m => m.InvoiceDate, new { @class = "control-label" })
                    @Html.EditorFor(m => m.InvoiceDate, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="form-group mb-2">
                    @Html.LabelFor(m => m.CustomerName, new { @class = "control-label" })
                    @Html.EditorFor(m => m.CustomerName, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="form-group mb-2">
                    @Html.LabelFor(m => m.CustomerAddress, new { @class = "control-label" })
                    @Html.EditorFor(m => m.CustomerAddress, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="form-group mb-2">
                    @Html.LabelFor(m => m.IsPaid, new { @class = "control-label" })
                    @Html.EditorFor(m => m.IsPaid)

                </div>
                <div class="form-group mb-2">
                    @Html.LabelFor(m => m.EmployeeId, new { @class = "control-label" })
                    @Html.DropDownListFor(m => m.EmployeeId, new SelectList(Model.Employees, "EmployeeId", "EmployeeName"), "Select Employee", new { @class = "form-control" })
                </div>
           </div>
                <div class="col-md-6">
                    <h4>Invoice Items</h4>
                    <button onclick="AddItem()" type="button" class="btn btn-warning mb-2">Add Item</button>
                    @Html.Partial("_AddInvoiceItems", Model.InvoiceItems.ToList())
                </div>
            </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-success">Save</button>
        </div>
    }
</div>
<script>
    function deleteItemRow(btn) { $(btn).closest('tr').remove(); updateItemIndex(); }
    function AddItem() {
        var lastIndex = parseInt($('#HIndex').val());
        var newRow = `
    <tr>
        <td><input type="text" value="" class="form-control" name="InvoiceItems[${lastIndex}].ProductName" /></td>
        <td><input type="number" value="" class="form-control" name="InvoiceItems[${lastIndex}].Quantity" /></td>
        <td><input type="number" step="0.01" value="" class="form-control" name="InvoiceItems[${lastIndex}].UnitPrice" /></td>
        <td><button onclick="deleteItemRow(this)" type="button" class="btn btn-danger">Delete</button></td>
    </tr>`;
        $("#ExTable tbody").append(newRow);
        $('#HIndex').val(lastIndex + 1);
        updateItemIndex();
    }
    function updateItemIndex() {
        $("#ExTable tbody tr").each(function (index) {
            $(this).find("input[name^='InvoiceItems']").each(function () {
                var name = $(this).attr("name");
                name = name.replace(/InvoiceItems\[\d+\]/, "InvoiceItems[" + index + "]");
                $(this).attr("name", name);
            });
        });
    }
</script>
